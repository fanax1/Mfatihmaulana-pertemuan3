	<queryString language="SQL">
		<![CDATA[SELECT 
            kode_sesi,
            COALESCE(NULLIF(email, ''), '-') AS email,
            nama_template,
            jumlah_cetakan,
            DATE_FORMAT(waktu_sesi, '%d-%m-%Y %H:%i') AS waktu_sesi,
            total_biaya
        FROM transaksi_sesi
        ORDER BY id DESC]]>
	</queryString>
